{
  "name": "workdsh-identity-portal",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "P1 身份打通（Host 半边）：把门户登录身份变成 DSH 内每个账号各自的主体。以 workdshIdentity 服务提供者身份运行，按「会话绑定优先 → 请求作用域门户身份 → 兜底主账号」的顺序解析 ActorContext。",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-storage-domain": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
