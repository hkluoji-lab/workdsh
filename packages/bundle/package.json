{
  "name": "workdsh-bundle",
  "version": "0.1.0-alpha.38",
  "private": true,
  "type": "module",
  "description": "WorkDSH default Harness bundle and client composition",
  "exports": {
    "./probe": {
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    ".": {
      "types": "./dist/probe.d.ts",
      "default": "./dist/probe.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "corepack pnpm --filter workdsh-ui build && corepack pnpm --filter workdsh-plugin-workbench build && corepack pnpm --filter workdsh-plugin-skills build && tsc -p tsconfig.json && node ../../scripts/build-client-probe.mjs",
    "typecheck": "corepack pnpm --filter workdsh-ui build && corepack pnpm --filter workdsh-plugin-workbench typecheck && corepack pnpm --filter workdsh-plugin-skills typecheck && tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.5-rc.1",
    "@deepseek-ai/dsh-skill": "0.1.5-rc.1",
    "@types/react": "19.2.14",
    "react": "19.2.4",
    "workdsh-ui": "workspace:*",
    "workdsh-plugin-skills": "workspace:*",
    "workdsh-plugin-workbench": "workspace:*"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
