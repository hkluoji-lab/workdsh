{
  "name": "workdsh-plugin-projects",
  "version": "0.1.0-alpha.1",
  "private": false,
  "type": "module",
  "description": "Project workspace, planning, configuration and asset references for WorkDSH",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.browser.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "corepack pnpm --filter workdsh-contracts build && tsc -p tsconfig.json && node ../../../scripts/build-projects.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.6-alpha.1",
    "react": "19.2.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.1"
    ,"@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-storage-json": "0.1.6-alpha.1",
    "@types/node": "22.19.0",
    "@types/react": "19.2.14",
    "react": "19.2.4",
    "workdsh-contracts": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.6-alpha.1"
    ,"@deepseek-ai/dsh-client-ui-conversation": "0.1.6-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
      "@deepseek-ai/dsh-client-ui-renderer"
      ,"@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
