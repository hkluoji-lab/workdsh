{
  "name": "workdsh-plugin-access",
  "version": "0.1.0-alpha.6",
  "private": true,
  "type": "module",
  "exports": {
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./tool": {
      "types": "./dist/tool.d.ts",
      "default": "./dist/tool.js"
    },
    "./grant-admin": {
      "types": "./dist/grant-admin.d.ts",
      "default": "./dist/grant-admin.js"
    },
    "./grant-baseline": {
      "types": "./dist/grant-baseline.d.ts",
      "default": "./dist/grant-baseline.js"
    },
    "./access-enforce": {
      "types": "./dist/access-enforce.d.ts",
      "default": "./dist/access-enforce.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "cordis.patch.yml",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "corepack pnpm --filter workdsh-contracts build && corepack pnpm build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@types/node": "22.19.0",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "workdsh-contracts": "workspace:*"
  }
}
